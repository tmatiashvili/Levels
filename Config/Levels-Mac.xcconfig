// Levels-Mac: menu-bar agent (ADR-0003, ADR-0013, ADR-0014, MAC-001).
#include "Levels.xcconfig"

SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx

PRODUCT_NAME = Levels
// Same ID as iOS to keep universal purchase possible (ADR-0003 §5).
PRODUCT_BUNDLE_IDENTIFIER = $(LEVELS_RDNS).levels
INFOPLIST_FILE = Levels-Mac/Info.plist

// One file for Debug and Release (lead's call 14). While the team is a free
// Personal Team it holds no iCloud or push keys (SETUP.md, "Free Personal
// Team"). With a paid team it gets them back, and aps-environment is
// `development`; exporting for Developer ID rewrites it to `production`.
CODE_SIGN_ENTITLEMENTS = Levels-Mac/Levels-Mac.entitlements

// ADR-0013 / MAC-001: Hardened Runtime on, no exceptions.
// App Sandbox OFF in Debug and Release (lead's call 16, 2026-11-23): MAC-003
// accessories are pulled forward, the AirPods source (system_profiler) returns
// nothing inside the sandbox (re-tested 2026-11-23), and the build is
// personal-only on a free Personal Team. The entitlements file has no sandbox
// key, so this setting agrees with it. LEVELS_UNSANDBOXED compiles the
// system_profiler reader (ADR-0013, MAC-003 R6); a future sandboxed App Store
// configuration drops the flag and keeps the IOKit HID reader.
// Leave ENABLE_USER_SELECTED_FILES empty: any value adds a files.* entitlement
// that MAC-001 AC11 does not allow.
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
ENABLE_OUTGOING_NETWORK_CONNECTIONS = YES
ENABLE_USER_SELECTED_FILES =
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) LEVELS_UNSANDBOXED

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
COMBINE_HIDPI_IMAGES = YES

// Release readiness (2026-11-24): same export-compliance answer as Levels-iOS
// (Apple encryption only). Needed if the Mac build ever goes through App Store
// Connect; harmless for the notarized direct download. Display name and
// category are already in Levels-Mac/Info.plist.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
