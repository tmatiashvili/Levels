// Levels-Mac: menu-bar agent (ADR-0003, ADR-0013, ADR-0014, MAC-001).
#include "Levels.xcconfig"

SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx

PRODUCT_NAME = Levels
// Same ID as iOS to keep universal purchase possible (ADR-0003 §5).
PRODUCT_BUNDLE_IDENTIFIER = $(LEVELS_RDNS).levels
INFOPLIST_FILE = Levels-Mac/Info.plist

// One file for Debug and Release (lead's call 14): aps-environment is
// `development`; exporting for TestFlight, App Store or Developer ID rewrites
// it to `production`.
CODE_SIGN_ENTITLEMENTS = Levels-Mac/Levels-Mac.entitlements

// ADR-0013 / MAC-001: Hardened Runtime on, no exceptions; sandbox on for
// v0.1–v0.2. The sandbox and network-client entitlements are written in the
// entitlements files; these settings agree with them so Xcode adds nothing.
// Leave ENABLE_USER_SELECTED_FILES empty: any value adds a files.* entitlement
// that MAC-001 AC11 does not allow.
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = YES
ENABLE_OUTGOING_NETWORK_CONNECTIONS = YES
ENABLE_USER_SELECTED_FILES =
// v0.3 (MAC-003, ADR-0013): add ENABLE_APP_SANDBOX[config=Release] = NO for the
// Developer ID build only, and make the entitlements file match.

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
COMBINE_HIDPI_IMAGES = YES
