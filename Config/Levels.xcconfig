// Levels.xcconfig — shared by every target (ADR-0003 §6).
// Set at project level ("Based on Configuration File") and #included by each
// per-target file in this folder.
//
// The owner's IDs (filled in 2026-11-23 when Levels.xcodeproj was created):
//   DEVELOPMENT_TEAM  10-character Team ID (Xcode > Settings > Accounts). For
//                     now this is the owner's free Personal Team (SETUP.md,
//                     "Free Personal Team").
//   LEVELS_RDNS       reverse-DNS prefix
// Bundle IDs, App Group IDs, the iCloud container and the keychain group are
// all derived from these two values; nothing else in the repo needs editing.

DEVELOPMENT_TEAM = N5P82JNFSC
LEVELS_RDNS = com.tmatiashvili

CODE_SIGN_STYLE = Automatic

// ADR-0002: OS 26 is the floor on every platform.
IPHONEOS_DEPLOYMENT_TARGET = 26.0
MACOSX_DEPLOYMENT_TARGET = 26.0
WATCHOS_DEPLOYMENT_TARGET = 26.0

// Swift 6 language mode, strict concurrency (MAC-001, RPT-001).
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
// Lead's call 15: same default isolation as the Shared package; UI types opt
// into @MainActor explicitly. (Xcode 26 templates default to MainActor.)
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated

// Release readiness (2026-11-24): one version for every app and extension. The
// App Store rejects an extension whose CFBundleShortVersionString or
// CFBundleVersion differs from its host app, so never override these per
// target. Bump CURRENT_PROJECT_VERSION for every upload to App Store Connect
// (and every notarized Mac build); bump MARKETING_VERSION per public release.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Release readiness: Release builds are optimised and dead-stripped; Debug
// keeps the project-level -Onone. `[config=Release]` so the target xcconfigs
// (which override project settings) leave Debug alone.
SWIFT_OPTIMIZATION_LEVEL[config=Release] = -O
GCC_OPTIMIZATION_LEVEL[config=Release] = s
DEAD_CODE_STRIPPING = YES
VALIDATE_PRODUCT[config=Release] = YES

// Release readiness: shown in Finder's Get Info and the Mac About panel.
LEVELS_COPYRIGHT = Copyright © 2026 Tornike Matiashvili. All rights reserved.
INFOPLIST_KEY_NSHumanReadableCopyright = $(LEVELS_COPYRIGHT)

// Push-driven widget updates (owner decision 2026-11-24, ADR-0023, PUSH-001).
// NO while the team is a free Personal Team: it can't sign `aps-environment`, so YES
// would break signing. With NO the build is the same as before push existed: the old
// entitlements files, no LEVELS_PUSH Swift flag, no push handler, no token upload, no relay.
// After enrolling (paid team): set YES and fill LEVELS_PUSH_RELAY_URL. The iPhone app and
// widget then sign with Config/*-Push.entitlements (aps-environment = development; exporting
// for TestFlight or the App Store rewrites it to production).
LEVELS_PUSH_ENABLED = NO
// The relay's https base URL, read by the Mac (Info.plist LevelsPushRelayURL). Empty = the
// Mac never calls the relay, even with LEVELS_PUSH_ENABLED = YES. xcconfig treats `//` as a
// comment, so write it as https:/$()/relay.example.workers.dev
LEVELS_PUSH_RELAY_URL =
// Swift flag per value of LEVELS_PUSH_ENABLED; targets add $(LEVELS_PUSH_SWIFT_FLAG_$(LEVELS_PUSH_ENABLED)).
LEVELS_PUSH_SWIFT_FLAG_YES = LEVELS_PUSH
LEVELS_PUSH_SWIFT_FLAG_NO =

// Info.plist: Xcode generates the standard CFBundle* keys and merges in each
// target's own Info.plist (INFOPLIST_FILE), which holds only the keys the
// specs require.
GENERATE_INFOPLIST_FILE = YES
