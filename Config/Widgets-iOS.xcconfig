// Widgets-iOS: iPhone widget extension, embedded in Levels-iOS (UI-003, NET-004).
// Links LevelsModel, LevelsUI, LevelsWidgetKit only (ADR-0003 §3).
#include "Levels.xcconfig"

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
// Same as Levels-iOS: iPhone only until UI-005.
TARGETED_DEVICE_FAMILY = 1

PRODUCT_NAME = LevelsWidgets
PRODUCT_BUNDLE_IDENTIFIER = $(LEVELS_RDNS).levels.widgets
INFOPLIST_FILE = Widgets-iOS/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Levels Widgets

// No iCloud here, so Debug and Release share one file. Push (LEVELS_PUSH_ENABLED in
// Levels.xcconfig): WidgetKit push needs aps-environment on the extension too, so YES
// switches to the push file and compiles the WidgetPushHandler (LEVELS_PUSH).
WIDGETS_IOS_ENTITLEMENTS_NO = Widgets-iOS/Widgets-iOS.entitlements
WIDGETS_IOS_ENTITLEMENTS_YES = Config/Widgets-iOS-Push.entitlements
CODE_SIGN_ENTITLEMENTS = $(WIDGETS_IOS_ENTITLEMENTS_$(LEVELS_PUSH_ENABLED))
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(LEVELS_PUSH_SWIFT_FLAG_$(LEVELS_PUSH_ENABLED))

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @executable_path/../../Frameworks
SKIP_INSTALL = YES
APPLICATION_EXTENSION_API_ONLY = YES
